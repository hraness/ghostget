{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghostget",
  "version": "0.18.3",
  "identifier": "com.ghostget.desktop",
  "build": {
    "frontendDist": "../out/native"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ghostget",
        "width": 1100,
        "height": 780,
        "minWidth": 700,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../out/runtime/": "ghostget-runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "14.5"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
