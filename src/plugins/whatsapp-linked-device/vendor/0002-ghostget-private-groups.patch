+package wa
+
+import (
+	"context"
+	"errors"
+	"go.mau.fi/whatsmeow/types"
+	"testing"
+)
+
+func TestPrivateSendGuardIsExactAndAbsentForOrdinarySends(t *testing.T) {
+	target, _ := types.ParseJID("120363000000000000@g.us")
+	if err := CheckPrivateSendGuard(context.Background(), target); err != nil {
+		t.Fatal(err)
+	}
+	calls := 0
+	denied := errors.New("membership changed")
+	ctx := WithPrivateSendGuard(context.Background(), func(_ context.Context, received types.JID) error {
+		calls++
+		if received != target {
+			t.Fatal("target rewritten")
+		}
+		return denied
+	})
+	if !errors.Is(CheckPrivateSendGuard(ctx, target), denied) || calls != 1 {
+		t.Fatal("guard skipped")
+	}
+}
