+package wa
+
+import (
+	"context"
+	"go.mau.fi/whatsmeow/types"
+)
+
+type privateSendGuardKey struct{}
+
+// WithPrivateSendGuard adds an exact final-effect check to the supervised path.
+// Ordinary commands carry no guard and retain their existing behavior.
+func WithPrivateSendGuard(ctx context.Context, check func(context.Context, types.JID) error) context.Context {
+	return context.WithValue(ctx, privateSendGuardKey{}, check)
+}
+func CheckPrivateSendGuard(ctx context.Context, target types.JID) error {
+	if check, ok := ctx.Value(privateSendGuardKey{}).(func(context.Context, types.JID) error); ok {
+		return check(ctx, target)
+	}
+	return nil
+}
